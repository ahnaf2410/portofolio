{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahnaf-portofolio",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only videos go through worker.js (adds Range / 206 support for Safari & seeking)
    "run_worker_first": ["/videos/*"]
  }
}
